# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used server-side, for privileged writes that must bypass RLS
# (e.g. resolving the HOD to route to). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL this app is deployed at (used to build links in emails)
NEXT_PUBLIC_APP_URL=https://adhoc-hiring.vercel.app

# --- Email (Google Apps Script relay — free, no App Password needed) ---
# See apps-script/Code.gs for the script to deploy and where these two
# values come from.
APPS_SCRIPT_URL=https://script.google.com/macros/s/xxxxxxxx/exec
APPS_SCRIPT_SECRET=choose-any-random-string

# Comma-separated HR distribution list — CC'd on every action so HR
# stays in the loop at every stage, per the brief.
HR_TEAM_EMAILS=hr1@fnp.com,hr2@fnp.com
