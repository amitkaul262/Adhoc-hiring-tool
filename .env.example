# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used server-side, for privileged writes that must bypass RLS
# (e.g. resolving the HOD to route to). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL this app is deployed at (used to build links in emails)
NEXT_PUBLIC_APP_URL=https://adhoc-hiring.vercel.app

# --- Email (Gmail/Workspace SMTP — free, no Brevo/Resend needed) ---
# Generate an App Password at myaccount.google.com/apppasswords (requires
# 2-Step Verification on the sending account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-mailbox@fnp.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM="FNP Adhoc Hiring <your-mailbox@fnp.com>"

# Comma-separated HR distribution list — CC'd on every action so HR
# stays in the loop at every stage, per the brief.
HR_TEAM_EMAILS=hr1@fnp.com,hr2@fnp.com
