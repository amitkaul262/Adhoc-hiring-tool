# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used server-side, for privileged writes that must bypass RLS
# (e.g. resolving the HOD to route to). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL this app is deployed at (used to build links in emails)
NEXT_PUBLIC_APP_URL=https://adhoc-hiring.vercel.app

# --- Email (Brevo SMTP, same as Rose) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM="FNP Adhoc Hiring <noreply@fnp.com>"

# Comma-separated HR distribution list — CC'd on every action so HR
# stays in the loop at every stage, per the brief.
HR_TEAM_EMAILS=hr1@fnp.com,hr2@fnp.com
